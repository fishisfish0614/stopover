,[44.3060956,15.6116671],[44.2849699,15.6037164],[44.2791247,15.5997958],[44.2765243,15.5935842],[44.2633761,15.5811761],[44.261633,15.5782069],[44.2625261,15.5714412],[44.2603513,15.5701664],[44.2359212,15.5713529],[44.233311,15.5692287],[44.2342184,15.5595067],[44.2330341,15.5583474],[44.2232375,15.5577229],[44.2108545,15.5535225],[44.2070006,15.5450363],[44.2007063,15.5412084],[44.1998525,15.5361564],[44.2005507,15.5292354],[44.1989493,15.5213377],[44.1995054,15.5132987],[44.2055035,15.5107842],[44.205521,15.5071507],[44.2022859,15.500822],[44.1973545,15.505681],[44.1908162,15.5052343],[44.1886526,15.5009952],[44.1904143,15.4963548],[44.1828122,15.4849657],[44.1649155,15.4833201],[44.1598336,15.4753607],[44.1433037,15.4705056],[44.1303066,15.4684395],[44.1244055,15.4658368],[44.1208276,15.462602]]]},"credit":{"model":"deepseek-flash","wiki":{"zh":"萨那","en":"Sanaa","voyage":"Sana'a"}}}