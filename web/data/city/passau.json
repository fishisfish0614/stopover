],[13.3726614,48.6079428],[13.3529453,48.6095196],[13.3532837,48.6073597],[13.3519523,48.6038462],[13.3507577,48.6038039],[13.3507995,48.6016307],[13.3231955,48.6036924],[13.3122915,48.6053622],[13.3079204,48.6076512],[13.3027058,48.6051739],[13.3023403,48.6027947]]]},"credit":{"model":"deepseek-flash","wiki":{"zh":"帕绍","en":"Passau","voyage":"Passau"}}}