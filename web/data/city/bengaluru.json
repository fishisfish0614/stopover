3,12.9550433],[77.4715488,12.9522356],[77.4725124,12.9516005],[77.4711219,12.9507249],[77.4710589,12.9495859],[77.4762791,12.9488226],[77.4732516,12.9403335],[77.478357,12.9375623],[77.4842436,12.9369206],[77.4838948,12.9338891],[77.4823156,12.9289551],[77.4809867,12.9274064],[77.4791188,12.927227],[77.4795953,12.9259171],[77.4733884,12.9266394],[77.4700802,12.9151921],[77.4664994,12.9101466],[77.4666715,12.9068778],[77.4600793,12.9066307]]]},"credit":{"model":"deepseek-v4-pro","wiki":{"zh":"班加羅爾","en":"Bengaluru","voyage":"Bengaluru"}}}