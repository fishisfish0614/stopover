,47.1261999],[15.4249921,47.1277418],[15.4227132,47.1284272],[15.4166421,47.1266828],[15.4124505,47.1298291],[15.4131678,47.1321925],[15.4008433,47.1345],[15.397542,47.1323687],[15.3997729,47.1254342],[15.3976474,47.1249304],[15.3963421,47.1227284],[15.3970887,47.1214751],[15.3965939,47.119903],[15.3949662,47.1187623],[15.39164,47.1129039],[15.3863602,47.1134406],[15.3789252,47.1121945],[15.3736839,47.1204798],[15.3727038,47.1186555],[15.3592122,47.1194911],[15.3596208,47.1158472],[15.3625714,47.11406],[15.3633342,47.1097456],[15.3534379,47.1071589],[15.3515417,47.1073997],[15.3498753,47.1065948],[15.349714,47.1047453]]]},"credit":{"model":"deepseek-v4-pro","wiki":{"zh":"格拉茨","en":"Graz","voyage":"Graz"}}}