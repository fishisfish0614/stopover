0.4409489],[22.0866279,60.4387732],[22.079205,60.4338469],[22.0758137,60.4286326],[22.078157,60.4255079],[22.0795834,60.4210178],[22.0845466,60.4189199],[22.0849832,60.413351],[22.0880979,60.4073427],[22.090384,60.3945618],[22.0792301,60.3801884],[22.0726804,60.3766274],[22.0686633,60.3769727],[22.0707737,60.3748431],[22.0685323,60.3702741],[22.0685468,60.3667768],[22.0661599,60.3652223]]]},"credit":{"model":"deepseek-v4-pro","wiki":{"zh":"圖爾庫","en":"Turku","voyage":"Turku"}}}