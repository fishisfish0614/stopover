407,33.8455644],[126.7058061,33.9176171],[126.5901386,33.9598918],[126.4954641,34.0206816],[126.3669852,34.0992545],[126.3215543,34.1248935],[126.3069115,34.139806],[126.2517309,34.1243535],[126.2175017,34.1087631],[126.172801,34.0805951],[126.0857945,34.0076688],[125.7940999,33.7395059]]]},"credit":{"model":"deepseek-v4-pro","wiki":{"zh":"濟州市","en":"Jeju City","voyage":"Jeju City"}}}