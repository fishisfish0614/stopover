,[23.8120136,54.9451673],[23.8042027,54.9543572],[23.8041138,54.9570004],[23.7993981,54.9486744],[23.7969515,54.941988],[23.7965247,54.9363793],[23.7929231,54.9280334],[23.7904615,54.929139],[23.786813,54.9262409],[23.7847974,54.9260383],[23.779903,54.9289039],[23.7645221,54.9321105],[23.7567132,54.9320952],[23.7535259,54.9310122]]]},"credit":{"model":"deepseek-v4-pro","wiki":{"zh":"考納斯","en":"Kaunas","voyage":"Kaunas"}}}