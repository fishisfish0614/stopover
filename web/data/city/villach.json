.7645589,46.6341975],[13.7625128,46.6312942],[13.7630648,46.6306409],[13.7601229,46.6309288],[13.7539858,46.6287524],[13.7476364,46.6240032],[13.7446715,46.623539],[13.7406766,46.6248037],[13.735695,46.6224313],[13.7281242,46.6219029],[13.7281379,46.6177651],[13.7308281,46.615116],[13.7294031,46.6132078],[13.72482,46.6128942],[13.7191889,46.6105818],[13.7079655,46.6106391],[13.6936945,46.6074227]]]},"credit":{"model":"deepseek-flash","wiki":{"zh":"菲拉赫","en":"Villach","voyage":null}}}