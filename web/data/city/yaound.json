,[11.5246275,3.9674308],[11.5138095,3.9691958],[11.5057973,3.9664898],[11.5002904,3.9660467],[11.5002404,3.9638957],[11.4908987,3.9634005],[11.4849544,3.9574697],[11.4822912,3.9577277],[11.4783023,3.9495198],[11.4792462,3.9473015],[11.4765152,3.9423326],[11.477511,3.9405145],[11.476026,3.9309436],[11.4767752,3.9252795],[11.474968,3.9211286],[11.475405,3.9176906],[11.4675682,3.9123465],[11.4670822,3.9094686],[11.4607444,3.9092323],[11.4581056,3.9065563],[11.4472264,3.9029302],[11.4465946,3.8998853],[11.4431274,3.9002434],[11.4403425,3.8991543],[11.4367896,3.8950714],[11.4321604,3.8939263],[11.4304858,3.8908762],[11.4252609,3.8893134],[11.4231967,3.8854053],[11.419735,3.8866005],[11.4111836,3.878661]]]},"credit":{"model":"deepseek-flash","wiki":{"zh":"雅温得","en":"Yaoundé","voyage":"Yaoundé"}}}