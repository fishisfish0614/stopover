,[5.2225349,50.9661041],[5.2224877,50.9644007],[5.2213503,50.9636715],[5.2221852,50.9612582],[5.2275388,50.9577267],[5.2272961,50.9567907],[5.2242806,50.9537624],[5.2229522,50.9508967],[5.2187428,50.9484813],[5.218646,50.9461194],[5.2121258,50.929438]]]},"credit":{"model":"deepseek-flash","wiki":{"zh":"哈瑟尔特","en":"Hasselt","voyage":null}}}