,36.3681833],[127.2774689,36.365233],[127.2717923,36.3624165],[127.270699,36.3609771],[127.2722408,36.3540951],[127.2772747,36.3499328],[127.2776106,36.3478718],[127.2756096,36.3447609],[127.2717687,36.3434343],[127.2698676,36.3397874],[127.2672047,36.3388454],[127.2672175,36.3336391],[127.2681424,36.3316339],[127.2667841,36.3298551],[127.26378,36.3276424],[127.2599176,36.3274349],[127.2605592,36.3241693],[127.2600035,36.3198627],[127.2583298,36.3187562],[127.257641,36.3169426],[127.2586302,36.3039899],[127.260836,36.3022485],[127.2591087,36.2959018],[127.2548236,36.2972334],[127.2527551,36.2964915],[127.2463188,36.2909082]]]},"credit":{"model":"deepseek-v4-pro","wiki":{"zh":"大田广域市","en":"Daejeon","voyage":"Daejeon"}}}