,40.225194],[44.4131987,40.2244956],[44.4138903,40.2213516],[44.408775,40.2247551],[44.4035749,40.2257352],[44.3975934,40.2252007],[44.3948323,40.2173076]]]]},"credit":{"model":"deepseek-flash","wiki":{"zh":"葉里溫","en":"Yerevan","voyage":"Yerevan"}}}