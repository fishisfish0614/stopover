,50.2495791],[15.8134581,50.2493261],[15.8136782,50.2506122],[15.8113573,50.2513292],[15.7988242,50.2533778],[15.7973001,50.2499955],[15.7917025,50.250828],[15.7907082,50.246899],[15.7890331,50.2455662],[15.7890038,50.2436475],[15.7881896,50.2443102],[15.7848229,50.2433002],[15.7810286,50.2443541],[15.7785802,50.2421828],[15.7817025,50.2387725],[15.7800925,50.2378882],[15.7821798,50.2364199],[15.7803009,50.2352494],[15.7741725,50.2349707],[15.7734422,50.2321942],[15.7530827,50.2366117],[15.7467677,50.2257647]]]},"credit":{"model":"deepseek-flash","wiki":{"zh":"赫拉德茨-克拉洛韦","en":"Hradec Králové","voyage":null}}}