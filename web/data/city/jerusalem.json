,31.8815347],[35.2070722,31.8791382],[35.2041564,31.8706964],[35.2064768,31.8653537],[35.2114614,31.8629902],[35.2117967,31.8584274],[35.2145319,31.8507563],[35.2138071,31.8471154],[35.2162139,31.8390209],[35.2151538,31.8260873],[35.2159462,31.8209618],[35.2151245,31.8190393],[35.2098308,31.8171357],[35.2101,31.8197636],[35.2076299,31.820586],[35.2076351,31.8225164],[35.2067137,31.823375],[35.2031724,31.8235181],[35.194737,31.8265811],[35.1841421,31.8259395],[35.1824385,31.8240728],[35.1818078,31.8208113],[35.1846765,31.8160917],[35.1842993,31.8140222],[35.1871341,31.8119652],[35.1876283,31.8093707],[35.1780755,31.8078787],[35.1694389,31.8084162],[35.1715469,31.806153],[35.1716465,31.8048243],[35.1704833,31.8032928],[35.167968,31.8034232],[35.1692483,31.8007104],[35.1676959,31.7983768],[35.1614108,31.7944533],[35.1631147,31.7920068],[35.1531403,31.7899739],[35.1519439,31.7889919],[35.1517961,31.7866384],[35.1471669,31.7868028],[35.1465954,31.7854012],[35.1409827,31.782945],[35.1406885,31.7814314],[35.1379929,31.7823073],[35.1380451,31.7867453],[35.1365307,31.7852622],[35.1337975,31.7880302],[35.1340608,31.7904312],[35.1366458,31.7923576],[35.1355384,31.7938626],[35.1332508,31.7933673],[35.1321059,31.7905145],[35.1310949,31.7902638],[35.1307194,31.7854496],[35.1297764,31.7853039],[35.1298887,31.7834596],[35.1313668,31.7821028],[35.1304504,31.780833],[35.1259524,31.7789144],[35.1252375,31.7760529]],[[35.1421499,31.7740656],[35.1424447,31.7789001],[35.1491023,31.7805318],[35.1489008,31.7827142],[35.150996,31.7832735],[35.1511385,31.7853161],[35.1619518,31.7893252],[35.163925,31.7911032],[35.1666907,31.7911717],[35.1682676,31.7900925],[35.1681128,31.7873317],[35.1707119,31.7856679],[35.1723193,31.7797136],[35.1801003,31.7803997],[35.168629,31.7779277],[35.167046,31.7792468],[35.1435298,31.7734163],[35.1421499,31.7740656]],[[35.2133441,31.740056],[35.2164622,31.7442948],[35.2188854,31.7435838],[35.2220161,31.7410414],[35.2251155,31.7407977],[35.2244167,31.7367988],[35.22